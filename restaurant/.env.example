# ─── El Choli POS · ejemplo de variables de entorno ────────────────────────
# Copia este archivo a `.env` y completa los valores reales.
# El .env NO se sube a git.

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-secreta-generada-en-produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=mi-dominio.com,www.mi-dominio.com,192.168.1.50
DJANGO_CSRF_TRUSTED_ORIGINS=https://mi-dominio.com,http://192.168.1.50
DJANGO_ENABLE_SSL=False

# Base de datos PostgreSQL
POSTGRES_DB=el_choli
POSTGRES_USER=el_choli
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Usuario inicial (por CÉDULA, así se inicia sesión en el POS).
# Se crea automáticamente en el primer arranque (User superuser + Vendedor).
DJANGO_SUPERUSER_CEDULA=1234567890
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contrasena-admin
DJANGO_SUPERUSER_NOMBRE=Admin
DJANGO_SUPERUSER_APELLIDOS=Administrador
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Backups (frecuencia en horas y retención en días)
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Puerto HTTP expuesto por nginx en el host
HTTP_PORT=80