# ─── El Choli POS · ejemplo de variables de entorno ────────────────────────
# Copia este archivo a `.env` y completa los valores reales.
# El .env NO se sube a git.

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-secreta-generada-en-produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=mi-dominio.com,www.mi-dominio.com,192.168.1.50
DJANGO_CSRF_TRUSTED_ORIGINS=https://mi-dominio.com,http://192.168.1.50
DJANGO_ENABLE_SSL=False

# Base de datos PostgreSQL
POSTGRES_DB=el_choli
POSTGRES_USER=el_choli
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Usuario inicial (por CÉDULA, así se inicia sesión en el POS).
# Se crea automáticamente en el primer arranque (User superuser + Vendedor).
DJANGO_SUPERUSER_CEDULA=1234567890
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contrasena-admin
DJANGO_SUPERUSER_NOMBRE=Admin
DJANGO_SUPERUSER_APELLIDOS=Administrador
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Correo SMTP para enviar facturas por email. Sin EMAIL_HOST, los
# correos se muestran en la consola (no se envían).
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=mifacturacion@tu-dominio.com
EMAIL_HOST_PASSWORD=cambia-esta-contrasena-del-correo
DEFAULT_FROM_EMAIL=mifacturacion@tu-dominio.com

# Licencia: código vendido al negocio, dirección de la API central y secreto
# compartido (debe coincidir con LICENCIA_SECRETO del servidor de licencias).
# El servidor de licencias se despliega APARTE (licencias_server/) y da
# servicio a varios POS, por eso se apunta por URL/host (no por red interna).
# Sin LICENCIA_CODIGO el sistema queda sin licencia (modo solo lectura).
LICENCIA_CODIGO=ELCHOLI-XXXXXX
LICENCIA_API_URL=https://licencias.tudominio.com/api/licencia/
LICENCIA_SECRETO=cambia-este-secreto-compartido
# Gracia (2 días), revalidación (cada 5 h) y aviso (2 días) ya traen valores
# por defecto; solo descomenta si necesitas cambiarlos.
# LICENCIA_GRACIA_DIAS=2
# LICENCIA_REVALIDACION_HORAS=5
# LICENCIA_DIAS_AVISO=2

# Backups (frecuencia en horas y retención en días)
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Puerto HTTP expuesto por nginx en el host
HTTP_PORT=80