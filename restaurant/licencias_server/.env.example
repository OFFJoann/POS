# ─── Servidor central de licencias · ejemplo de variables ──────────────────
# Copia este archivo a `.env` y completa los valores reales.
# El `.env` NO va a git.

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=licencias.tudominio.com

# Secreto compartido para firmar/verificar licencias (HMAC-SHA256).
# DEBE ser idéntico al LICENCIA_SECRETO de cada POS.
LICENCIA_SECRETO=cambia-este-secreto-compartido

# Superusuario del panel de administración (se crea en el primer arranque).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contrasena-admin
DJANGO_SUPERUSER_EMAIL=admin@tudominio.com

# Puerto del host donde se expone el servidor (admin + API)
LICENCIAS_HTTP_PORT=8010
GUNICORN_WORKERS=2

# Opcional: si se define DB_HOST se usa PostgreSQL en lugar de SQLite.
# DB_NAME=licencias
# DB_USER=licencias
# DB_PASSWORD=cambia-esta-contrasena
# DB_HOST=localhost
# DB_PORT=5432