# ─── Router multi-POS · El Choli ──────────────────────────────────────────────
# Un nginx por servidor que reparte por subdominio a cada instancia POS.
#
# En este archivo defines SOLO la configuración del router:
#   ROUTER_SSL=false            → sirve por HTTP en el puerto indicado
#   ROUTER_HTTP_PORT=80         → puerto HTTP (con host network, del host)
#   ROUTER_HTTPS_PORT=443       → puerto HTTPS (solo si ROUTER_SSL=true)
#
# Después, UNA línea por instancia:   subdominio=puerto_del_POS
#
# Genera el nginx.conf con:
#   ./generar_conf.sh
# y levanta el router con:
#   docker compose up -d

ROUTER_SSL=false
ROUTER_HTTP_PORT=80
ROUTER_HTTPS_PORT=443

# ─── Instancias ──────────────────────────────────────────────────────────────
# formato: subdominio=puerto (el mismo puerto de HTTP_PORT en el .env del POS)
pos1.tudominio.com=8081
pos2.tudominio.com=8082